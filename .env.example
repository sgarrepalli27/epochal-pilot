# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Epochal Time Portal (date-gated web search/fetch): https://epochal.com
EPOCHAL_API_KEY=

# OpenRouter (System Two / optional --analyst): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic Claude API (optional, --backend anthropic): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# TypeSafe Jev (recommended System One default when set): --backend jev or jev-rules
# https://docs.typesafe.ai
TYPESAFE_API_KEY=

# Official OpenAI Decisions API (--backend openai-decisions) or structured fallback (--backend openai)
# https://developers.openai.com/api/docs/guides/decisions
OPENAI_API_KEY=

# Official Gemini Decisions API (--backend gemini-decisions) or structured fallback (--backend gemini)
# https://aistudio.google.com/docs/decisions-api
# GEMINI_API_KEY is preferred; GOOGLE_API_KEY is accepted as a fallback.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional provider plugin: a module that calls epochal_pilot.providers.register
# EPOCHAL_PILOT_PROVIDER_MODULE=my_package.providers

# No key needed for --backend ollama (local), --backend claude-cli (your Claude Code login),
# or --backend rules (deterministic checklist).

# Optional
# OLLAMA_HOST_URL=http://localhost:11434
# EPOCHAL_PILOT_CACHE_DIR=.epochal-pilot-cache
# EPOCHAL_PILOT_MAX_TOTAL=90
# OLLAMA_NUM_CTX=16384          # lower (e.g. 8192) if Ollama runs out of memory
# CLAUDE_CLI=claude             # path or name of the Claude Code executable
# CLAUDE_CLI_TIMEOUT=300        # seconds per claude-cli call
